{
  "name": "tiny-ai-chat",
  "version": "0.0.0",
  "private": true,
  "description": "An AI chat widget for any website in about 10 KB, with a relay that keeps your API key on the server and streams from OpenAI, Gemini or Claude. Built with lithent.",
  "keywords": [
    "ai",
    "chat",
    "widget",
    "chatbot",
    "custom-element",
    "web-component",
    "openai",
    "gemini",
    "claude",
    "lithent"
  ],
  "license": "MIT",
  "author": "superlucky84",
  "homepage": "https://github.com/superlucky84/tiny-ai-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superlucky84/tiny-ai-chat.git"
  },
  "bugs": {
    "url": "https://github.com/superlucky84/tiny-ai-chat/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/tiny-ai-chat.js",
    "./dist/tiny-ai-chat.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/tiny-ai-chat.d.ts",
      "default": "./dist/tiny-ai-chat.mjs"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "default": "./dist/relay/index.js"
    },
    "./relay/openai": {
      "types": "./dist/relay/openai.d.ts",
      "default": "./dist/relay/openai.js"
    },
    "./relay/gemini": {
      "types": "./dist/relay/gemini.d.ts",
      "default": "./dist/relay/gemini.js"
    },
    "./relay/anthropic": {
      "types": "./dist/relay/anthropic.d.ts",
      "default": "./dist/relay/anthropic.js"
    },
    "./relay/node": {
      "types": "./dist/relay/node.d.ts",
      "default": "./dist/relay/node.js"
    },
    "./relay/fake": {
      "types": "./dist/relay/fake.d.ts",
      "default": "./dist/relay/fake.js"
    },
    "./protocol": {
      "types": "./dist/shared/protocol.d.ts",
      "default": "./dist/shared/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "jsdelivr": "dist/tiny-ai-chat.js",
  "unpkg": "dist/tiny-ai-chat.js",
  "files": [
    "dist",
    "!dist/index.html"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/size.mjs && node scripts/check-bundle.mjs && node scripts/build-demo.mjs",
    "size": "node scripts/size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"e2e/**/*.{ts,mjs}\" \"demo/**/*.js\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{js,json,html}\" \"templates/**/*.{mjs,ts,json}\" \"e2e/**/*.{ts,mjs,html}\" \"demo/**/*.{js,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.{js,json,html}\" \"templates/**/*.{mjs,ts,json}\" \"e2e/**/*.{ts,mjs,html}\" \"demo/**/*.{js,html}\"",
    "type-check": "tsc --noEmit",
    "check:templates": "node scripts/check-templates.mjs",
    "test:mutations": "node scripts/check-mutations.mjs",
    "test:e2e": "playwright test",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@google/genai": "^3.6.1",
    "openai": "^7.62.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@eslint/js": "^9.16.0",
    "@google/genai": "3.6.1",
    "@lithent/lithent-vite": "^0.4.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^22.12.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "lithent": "^1.26.0",
    "openai": "7.62.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^8.3.6",
    "vite-plugin-checker": "^0.8.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.28.0"
}
