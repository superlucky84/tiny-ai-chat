# Copy to .env and fill in. Never commit .env.

# fake (no key, for trying it out), openai, gemini or anthropic
PROVIDER=fake

# The model ID from your provider's model list, e.g. claude-opus-5-5
MODEL=

# The key for the provider you chose
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Instructions for the model. Visitors can find them out: no secrets here.
SYSTEM_PROMPT=You answer questions about example.com. Keep answers short.

# Sites allowed to use this relay, comma-separated, e.g. https://example.com
ALLOWED_ORIGINS=

PORT=8787
